# Copy to apps/api/.env for local development. Production values are
# documented in docs/deployment.md; never commit real secrets.
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:4200
DATABASE_URL=postgresql://rentflow:rentflow_dev_password@localhost:5432/rentflow?schema=public
LOG_LEVEL=debug
# Background jobs (billing, lease expiry, cleanup). Safe on every instance.
ENABLE_JOBS=true
# Email: log (development only), resend, or smtp.
MAIL_PROVIDER=log
MAIL_FROM=RentFlow <no-reply@localhost>
# RESEND_API_KEY=
# SMTP_URL=smtps://user:password@smtp.example.com:465
# Number of trusted reverse-proxy hops in front of the API (0 locally).
TRUST_PROXY=0
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=120
# Two-step sign-in. Optional outside production (a fixed development key is used).
# MFA_ENCRYPTION_KEY=
# Uploaded documents. Local files under apps/api/.data/uploads by default (gitignored).
STORAGE_DRIVER=local
# STORAGE_DIR=.data/uploads
UPLOAD_MAX_MB=10
