# Copy to .env.production at the repository root. Never commit the real file.
SITE_ADDRESS=app.example.com
WEB_ORIGIN=https://app.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-value
DATABASE_URL=postgresql://rentflow:change-me-to-a-long-random-value@postgres:5432/rentflow?schema=public&connection_limit=10
LOG_LEVEL=log
ENABLE_JOBS=true
# Email is required in production (password reset, verification, invitations).
MAIL_PROVIDER=resend
MAIL_FROM=RentFlow <no-reply@example.com>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Or: MAIL_PROVIDER=smtp and SMTP_URL=smtps://user:password@smtp.example.com:465
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=120
# Uploaded documents (tenant IDs, signed leases). Default: the "uploads" volume (back it up).
STORAGE_DRIVER=local
UPLOAD_MAX_MB=10
STORAGE_QUOTA_MB=2048
# Or a PRIVATE S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO):
# STORAGE_DRIVER=s3
# S3_BUCKET=rentflow-documents
# S3_REGION=ap-southeast-1            # "auto" for Cloudflare R2
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS S3
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=false           # true for MinIO
